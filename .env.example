# Copy to .env (or .env.local) and fill in values.
# Docs: https://docs.hottubapp.io/developers/stash-bridge/

# Stash base URL used by the bridge for GraphQL
STASH_URL=http://127.0.0.1:9999

# Sent as ApiKey header to Stash (Settings → Security → Authentication)
STASH_API_KEY=

# Rewrites loopback media URLs so phones on LAN can fetch streams/thumbs
# Example: http://192.168.1.10:9999
STASH_PUBLIC_URL=

# Bridge listen address / port
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3099

# Identity returned by POST /api/status
SOURCE_ID=stash
SOURCE_NAME=Stash
SOURCE_SUBTITLE=Local Stash library
SOURCE_DESCRIPTION=Browse and play scenes from your Stash server in Hot Tub.
SOURCE_COLOR=#c41e3a

# Optional: require Authorization: Bearer <token> on API routes
BRIDGE_BEARER_TOKEN=
